{"human_approval":{"note":"只有这几类事才推给人批奏折，其他 Agent 自行处理","types":["sop-rule-change","strategy-pivot","final-title-pick","public-announce","spend-money"]},"note":"事件 → 处理规则。学 @Khazix0918 的中台：统一事件格式，按规则路由到 Skill，只有 needs_human 命中的才找人批奏折。","rules":[{"dedup_key":"daily-{{date}}","name":"每日定时迭代","needs_human":["sop-rule-change","strategy-pivot"],"run":{"skill":"daily-optimizer","steps":["data-analyst 拉取三频道昨日公开数据","对比历史基线找异常","输出迭代报告到 reports/","有 SOP 级发现时提 PR 改 sop/"]},"when":{"description":"每天美东 8 点","schedule":"0 8 * * *","source":"cron"}},{"dedup_key":"data-{{pr}}","name":"新数据提交","needs_human":[],"run":{"skill":"data-analyst","steps":["校验数据格式","并入当日汇总","触发一次轻量迭代分析"]},"when":{"paths":["data/daily/*"],"source":"github","types":["pull_request.opened"]}},{"dedup_key":"title-{{pr}}","name":"新标题/选题提交","needs_human":["final-title-pick"],"run":{"skill":"title-generator","steps":["按标题 SOP 评审","给出 A/B 候选 + 评分","评论在 PR 里"]},"when":{"paths":["channels/*/videos/*"],"source":"github","types":["pull_request.opened"]}},{"dedup_key":"publish-{{video_id}}","name":"新视频发布","needs_human":[],"run":{"skill":"data-analyst","steps":["归档 meta 到 channels/","启动 24h/72h 数据追踪"]},"when":{"source":"manual","types":["video.published"]}}],"timezone":"America/New_York","version":"1.0.0"}